# Server-only Gemini settings. Never prefix the API key with VITE_.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3-flash-preview
CROP_CONCURRENCY=5
CROP_DPI=150
HOST=127.0.0.1

# Supabase Auth settings used by the Express API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_SUPABASE_KEY
# Required only by Vercel server functions. Never prefix this with VITE_.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_ONLY_KEY
ALLOWED_EMAIL_DOMAIN=YOUR_SCHOOL_DOMAIN.edu
CRON_SECRET=YOUR_RANDOM_CRON_SECRET

# The matching public settings used by the React client.
# A Supabase publishable key is safe to expose; never put a service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_SUPABASE_KEY
VITE_ALLOWED_EMAIL_DOMAIN=YOUR_SCHOOL_DOMAIN.edu

# true lets a valid school-domain email create a Supabase user on first OTP login.
# Use false if accounts will be invited or created by an administrator.
VITE_SUPABASE_ALLOW_SIGNUPS=true
# Set true in Vercel. Keep false or omit for the existing local Express workflow.
VITE_SERVERLESS_MODE=true
