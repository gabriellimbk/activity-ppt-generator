{
  "name": "collaborative-activity-generator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "vite build && tsc -p tsconfig.server.json && tsc -p tsconfig.api.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "lint": "eslint src server api --max-warnings=0"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@supabase/supabase-js": "^2.57.4",
    "@vercel/queue": "^0.5.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tus-js-client": "^4.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^6.0.3",
    "@vercel/node": "^5.10.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.2.1",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.8"
  },
  "type": "module"
}
